@startuml ch5-domain-model
' F5.5 Domain model (conceptual): attributes only, no methods.
' Verified against: src/aegis/memory/store.py (_SCHEMA tables, CHECK enums, FKs),
' src/aegis/memory/relations.py (RELATIONS), src/aegis/memory/runs.py (_event_type),
' Enum values (relation, event_type) are listed in the figure caption, not drawn.
' src/aegis/memory/ingest.py (moved_while_unobserved), src/aegis/memory/personal.py
!include _aegis_style.iuml

hide methods
hide circle
skinparam ClassBackgroundColor $MB_FILL
skinparam ClassBorderColor $MB_BORDER
skinparam ClassBorderThickness 1.2
skinparam ClassAttributeFontSize 12
skinparam ClassFontStyle bold
skinparam PackageBorderColor $NEUTRAL_BORDER
skinparam PackageFontStyle plain
skinparam ArrowFontSize 11

class Home {
  home_id
}
class Session {
  started_at, ended_at
  time_source
  keyframe_count
}
class Room {
  label, room_type
  label_source {auto, caregiver}
}
class Anchor {
  canonical, label
  match_quality
}
class ObjectInstance {
  canonical, label
  importance
  last-known state
}
class StateRun {
  relation
  relation_certain
  start_at, end_at
  confidence
}
class Event {
  event_type
  start_at, end_at
}
class Activity {
  start_at, end_at
  summary
}
class RoomVisit {
  start_at, end_at
}
class Evidence {
  crop path
  captured_at
}
class Summary {
  level {day, week, month}
  kind {object, activity}
  text
}
class PersonalItem {
  alias
  usual_anchor, usual_room
}

class "Caregiver access\n(planned, FR8)" as Planned #FFFFFF;line.dashed;line:6B7785 {
  Caregiver, AccessGrant,
  AuditEntry
}

Home *-- "0..*" Session
Home *-- "0..*" Room
Planned .right. Home : grants\naccess to
Session "1" -right- "0..*" RoomVisit
Session "1" -- "0..*" Activity
Session "1" -- "0..*" StateRun
RoomVisit "0..*" -right- "1" Room
Room "0..1" -- "0..*" StateRun : in
Room "0..1" -- "0..*" Anchor : contains
ObjectInstance "1" -- "1..*" StateRun : history
StateRun "0..*" -- "0..1" Anchor : relative to
ObjectInstance "0..1" -- "0..*" Event
Activity "0..1" -- "0..*" Event : groups
Activity -[hidden]right- StateRun
Evidence -[hidden]right- Anchor
StateRun "0..1" -- "0..1" Evidence
ObjectInstance "1" -up- "0..*" Summary : summarises
ObjectInstance "1" -up- "0..1" PersonalItem : enrols

@enduml
