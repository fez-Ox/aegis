@startuml ch5-domain-model
' F5.5 Domain model (conceptual): attributes only, no methods.
' Verified against: src/aegis/memory/store.py (_SCHEMA tables, CHECK enums, FKs),
' src/aegis/memory/relations.py (RELATIONS), src/aegis/memory/runs.py (_event_type),
' src/aegis/memory/ingest.py (moved_while_unobserved), src/aegis/memory/personal.py
!include _aegis_style.iuml
!pragma layout smetana

hide methods
hide circle
skinparam ClassBackgroundColor $MB_FILL
skinparam ClassBorderColor $MB_BORDER
skinparam ClassBorderThickness 1.2
skinparam ClassAttributeFontSize 12
skinparam ClassFontStyle bold
skinparam PackageBorderColor $NEUTRAL_BORDER
skinparam PackageFontStyle plain
skinparam ArrowFontSize 11

class Home {
  home_id
}
class Session {
  started_at, ended_at
  time_source
  keyframe_count
}
class Room {
  label, room_type
  label_source {auto, caregiver}
}
class Anchor {
  canonical, label
  match_quality
}
class ObjectInstance {
  canonical, label
  importance
  last-known state
}
class StateRun {
  relation
  relation_certain
  start_at, end_at
  confidence
}
class Event {
  event_type
  start_at, end_at
}
class Activity {
  start_at, end_at
  summary
}
class RoomVisit {
  start_at, end_at
}
class Evidence {
  crop path
  captured_at
}
class Summary {
  level {day, week, month}
  kind {object, activity}
  text
}
class PersonalItem {
  alias
  usual_anchor, usual_room
}

package "Planned (FR8)" #FFFFFF {
  class Caregiver #FFFFFF;line.dashed;line:6B7785
  class AccessGrant #FFFFFF;line.dashed;line:6B7785
  class AuditEntry #FFFFFF;line.dashed;line:6B7785
}

Home *-- "0..*" Session
Home *-- "0..*" Room
Session "1" -- "0..*" RoomVisit
Session "1" -- "0..*" Activity
Session "1" -- "0..*" StateRun
Room "1" -- "0..*" RoomVisit
Room "0..1" -- "0..*" StateRun : in
Room "0..1" -- "0..*" Anchor : contains
ObjectInstance "1" -- "1..*" StateRun : history
StateRun "0..*" -right- "0..1" Anchor : relative to
ObjectInstance "0..1" -- "0..*" Event
Activity "0..1" -- "0..*" Event : groups
StateRun "0..1" -- "0..1" Evidence
ObjectInstance "1" -- "0..*" Summary : summarises
ObjectInstance "1" -- "0..1" PersonalItem : enrols
Caregiver "1" .. "0..*" AccessGrant
Caregiver "1" .. "0..*" AuditEntry
Home "1" .up. "0..*" AccessGrant
RoomVisit -[hidden]right- StateRun
StateRun -[hidden]right- Anchor

note bottom of StateRun
  relation: inside, on_surface, under, above,
  next_to, on_floor, near, in_room, carried_by_user
end note
note bottom of Event
  pickup, placement, anchor_change,
  state_change, room_change,
  moved_while_unobserved
end note
@enduml
