@startuml ch7-class-query-api-apps
' F7.2 Query, API and app classes. Key members only.
' Verified against: src/aegis/nlq/engine.py, nlq/dictionary.py,
' src/aegis/memory/reasoning.py (QueryReasoningEngine, rank_candidates),
' src/aegis/core/config.py (RankingConfig), src/aegis/remote/api.py
' (query_memory, ask_question, MemoryQueryResponse, AskResponse),
' apps/Patient App/lib/services/api_service.dart, voice_service.dart,
' apps/Patient App/lib/models/memory_answer.dart
!include _aegis_style.iuml
!include _aegis_class.iuml
skinparam class<<utility>> {
  BackgroundColor #FFFFFF
  BorderColor $NEUTRAL_BORDER
}

  class ApiService <<app>> {
    +baseUrl: String
    +requestTimeout = 8 s
    --
    +ask(text, cue): MemoryAnswer
    +lookupObject(label, cue)
    +isServerLive(): bool
  }
  class MemoryAnswer <<app>> {
    +mode: ResolutionMode
    +candidates: List<MemoryCandidate>
    --
    +fromQuery(json)
    +fromAsk(json)
  }
  interface VoiceService <<interface>> {
    +start(), stop(), cancel()
  }
  class DeviceVoiceService <<app>>

  class "routes" as routes <<utility>> {
    +query_memory(item): MemoryQueryResponse
    +ask_question(text): AskResponse
  }
  class MemoryQueryResponse <<infra>> {
    +found: bool
    +location_summary: str
    +crop_url: str | None
    +resolution_mode: str | None
    +candidates: list[dict]
  }
  class AskResponse <<infra>> {
    +found: bool
    +answer: str
    +abstain_reason: str | None
    +evidence: list[dict]
  }

  class "ranking" as ranking <<utility>> {
    +rank_candidates(states, target,\n  cues, config, personal_ids): dict
  }
  class RankingConfig <<query>> {
    +candidate_limit = 3
    +ambiguity_margin = 0.08
    +w_vip, w_act, w_disp, w_rec
  }

  class AnswerEngine <<query>> {
    +classify_intent(question): Intent
    +ask(question, memory): AskResult
  }
  class DictionaryIndex <<query>> {
    +lookup_item(query): Slots
    +suggestions_for(unknown): list
  }
  class AskResult <<query>> {
    +status: str
    +answer: str
    +abstained: bool
    +evidence: list[dict]
  }
  enum Intent <<query>> {
    LOCATE
    TEMPORAL
    ACTIVITY
    UNKNOWN
  }

VoiceService <|.. DeviceVoiceService
ApiService ..> MemoryAnswer : creates
ApiService ..> routes : GET /query,\nGET /ask
routes ..> MemoryQueryResponse
routes ..> AskResponse
routes ..> ranking : /query
routes ..> AnswerEngine : /ask
ranking ..> RankingConfig
AnswerEngine --> "1" DictionaryIndex
AnswerEngine ..> AskResult
AnswerEngine ..> Intent

legend bottom right
  |<#E9DFF2> | Patient App, Flutter (M-D) |
  |<#F1F3F5> | aegis.remote.api models |
  |<#FCE8D0> | aegis.nlq, aegis.memory.reasoning (M-C) |
  |<#FFFFFF> | «utility» module functions, «interface» |
endlegend
@enduml
