@startuml ch6-class-live
' F6.2a Iteration 1 live capture classes, as at tag v0.2.0-mid2 (13 Oct 2026).
' Verified against: git show v0.2.0-mid2:src/aegis/ingestion/live_source.py,
' live_storage.py, live_pipeline.py, src/aegis/remote/api.py, src/aegis/memory/reasoning.py
!include _aegis_style.iuml
!include _aegis_class.iuml
skinparam class<<utility>> {
  BackgroundColor #FFFFFF
  BorderColor $MA_BORDER
}

interface FrameSource <<interface>> {
  +frames(): Iterator[DecodedFrame]
}
class OpenCVMjpegSource <<capture>> {
  +url: str
  --
  +frames(): Iterator[DecodedFrame]
}
class DecodedFrame <<capture>> {
  +image: Any
  +received_at: datetime
}
class "live_pipeline" as LP <<utility>> {
  +ingest_live(source_factory, config)
}
class LiveIngestionConfig <<capture>> {
  +output_root: Path
  +source_id: str
  +sample_fps = 2.0
  +max_duration_seconds = 600.0
  +reconnect_interval_seconds = 3.0
  +reconnect_timeout_seconds = 30.0
  +source_protocol = "http-mjpeg"
  +source_url: str | None
}
class LiveIngestionResult <<capture>> {
  +session_id: str
  +output_dir: Path
  +frames: int
  +status: str
}
class LiveSessionWriter <<capture>> {
  +session_dir: Path
  +count: int
  --
  +write(image, received_at, ...): dict
  +close(...)
}

FrameSource <|.. OpenCVMjpegSource
FrameSource ..> DecodedFrame : yields
LP ..> FrameSource : reads
LP ..> LiveIngestionConfig : uses
LP ..> LiveSessionWriter : uses
LP ..> LiveIngestionResult : returns

legend bottom right
  |<#DCE9F7> | aegis.ingestion, live capture (M-A) |
  |<#FFFFFF> | «utility» module functions, «interface» |
endlegend
@enduml
